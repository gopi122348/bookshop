container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py migrate --fake-initial --noinput"
    leader_only: true
  02_createsuperuser:
    command: "source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py shell -c \"from django.contrib.auth import get_user_model; U=get_user_model(); U.objects.filter(username='admin').exists() or U.objects.create_superuser('admin','admin@example.com','admin123')\""
    leader_only: true
