container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
    leader_only: true
  03_resetpassword:
    command: "source /var/app/venv/*/bin/activate && python manage.py shell -c \"from django.contrib.auth.models import User; u, created = User.objects.get_or_create(username='admin'); u.set_password('NewPassword123'); u.is_superuser=True; u.is_staff=True; u.save(); print('Done')\""
    leader_only: true